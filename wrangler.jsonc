{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opus-folio",
  "compatibility_date": "2026-08-30",

  // A static site: no Worker script, just the built assets. Committing this
  // stops `wrangler deploy` from trying to configure the project mid-deploy,
  // which is what failed CI (it ran `astro add cloudflare`, whose pnpm install
  // tripped ERR_PNPM_IGNORED_BUILDS on workerd).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
