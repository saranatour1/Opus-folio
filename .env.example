# Copy to .env and fill in. Validated by the schema in astro.config.mjs.

# Where the site is deployed. Drives canonical, og:url, sitemap.xml and robots.txt.
PUBLIC_SITE_URL="https://opus.example"

# Contact address shown in the footer.
PUBLIC_CONTACT_EMAIL="hello@example.com"

# Optional. Byline on X cards, e.g. "@opus". Omitted from the markup when blank.
PUBLIC_X_HANDLE=""

# Optional. ImageKit endpoint, e.g. "https://ik.imagekit.io/your_id".
# Set it and the social card is served (and resized) through the CDN instead of
# straight from /og.png. https://docs.astro.build/en/guides/media/imagekit/
PUBLIC_IMAGEKIT_URL_ENDPOINT=""
