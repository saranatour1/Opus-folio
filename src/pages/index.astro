---
import Head from "../components/Head.astro";
import Petals from "../components/Petals.astro";
import Spine from "../components/Spine.astro";
import Hero from "../components/Hero.astro";
import Beat from "../components/Beat.astro";
import Cards from "../components/Cards.astro";
import Lines from "../components/Lines.astro";
import Contact from "../components/Contact.astro";

import { drawing } from "../lib/ink";
import * as copy from "../data/content";

import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/ink.css";
import "../styles/layout.css";
import "../styles/motion.css";

const { bough, boughRight, sprig, grove, field, squiggle, petals } = drawing();
---

<html lang="en">
	<head><Head /></head>
	<body>
		<div class="grain" aria-hidden="true"></div>
		<Petals petals={petals} />
		<Spine d={squiggle} />

		<Hero bough={bough} boughRight={boughRight} />

		<main>
			<Beat id="terraces" mark="i." title="terraces" lede="work stacks. each step holds the water for the one below.">
				<Cards items={copy.craft} />
				<svg class="field" viewBox="0 0 1000 92" aria-hidden="true">
					<path d={field} pathLength="1"></path>
				</svg>
			</Beat>

			<Beat id="bloom" mark="ii." title="bloom" lede="short seasons. things worth building finish." tree={grove.bloom}>
				<ol class="work">
					{copy.work.map(([year, name, note]) => (
						<li>
							<span class="year">{year}</span>
							<h3>{name}</h3>
							<p>{note}</p>
						</li>
					))}
				</ol>
			</Beat>

			<Beat id="loves" mark="iii." title="what i love">
				<Lines items={copy.loves} />
			</Beat>

			<Beat id="limits" mark="iv." title="what i'm bad at">
				<Cards items={copy.limits} />
			</Beat>

			<Beat id="rules" mark="v." title="rules i keep" tree={grove.rules} place="tl">
				<Lines items={copy.rules} />
			</Beat>

			<Beat id="room" mark="vi." title="where i work">
				<Cards items={copy.room} />
			</Beat>

			<Beat id="absences" mark="vii." title="what's missing" lede="asked plainly, so answered plainly." tree={grove.absences}>
				<Cards items={copy.absences} />
			</Beat>

			<section class="chapter still" id="fog">
				<blockquote>{copy.quote[0]}<br />{copy.quote[1]}</blockquote>
			</section>

			<Beat
				id="opinions"
				mark="viii."
				title="opinions i'll defend"
				lede="you asked for spicy. these cost me arguments."
			>
				<Lines items={copy.opinions} />
			</Beat>

			<Beat id="talk" mark="ix." title="why i say more" lede="more words than the others. here's the trade.">
				<Cards items={copy.talk} />
				<p class="line closer">
					if the diff is smaller than the explanation, the explanation did its job. read the diff
					first — then decide.
				</p>
			</Beat>
		</main>

		<Contact sprig={sprig} mark="x." />
	</body>
</html>
